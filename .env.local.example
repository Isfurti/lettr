# Required for AI features (bullet rewriting, cover letter generation)
ANTHROPIC_API_KEY=sk-ant-...

# Razorpay payments (one-time Pro passes). See README "Billing setup".
# Test keys (rzp_test_...) take no real money.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
# Razorpay dashboard → Webhooks → https://your-domain/api/billing/webhook, events order.paid + payment.captured
RAZORPAY_WEBHOOK_SECRET=...
# Set to "on" once Razorpay approves international payments (USD/GBP/EUR/AUD prices).
# RAZORPAY_INTERNATIONAL=on

# Google Drive export (Pro feature) AND "Sign in with Google" - same OAuth
# app, see README "Social login setup" section for the two redirect URIs
# you need to register.
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...

# "Sign in with LinkedIn" - see README "Social login setup" section
LINKEDIN_CLIENT_ID=...
LINKEDIN_CLIENT_SECRET=...

# Error monitoring (optional but recommended for production). See README
# "Monitoring & ops setup" section.
NEXT_PUBLIC_SENTRY_DSN=https://...@...ingest.sentry.io/...
SENTRY_DSN=https://...@...ingest.sentry.io/...
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=your-project-slug

# Admin support inbox - your own email, gates access to /admin/support
ADMIN_EMAIL=you@example.com

# Optional - email notifications for new support messages (works fine
# without this, messages just won't push-notify you, only show in the inbox)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=support@your-domain.com

# Postgres connection string. For local dev, install Postgres and:
#   createdb resumeai
# For production, use a managed provider (Neon, Supabase, Railway, RDS) and
# paste the connection string they give you.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/resumeai

# Required for NextAuth session encryption. Generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-random-32-byte-secret

# Only needed if deploying somewhere the URL isn't auto-detected
# NEXTAUTH_URL=https://your-domain.com

# Review analysis runs through Anthropic's half-price batch API and the
# reply is emailed (daily job in vercel.json). Set to "instant" to analyse
# on the spot instead. Optional: CRON_SECRET makes the daily job callable
# only by Vercel's scheduler.
# REVIEW_ANALYSIS=instant
# CRON_SECRET=
